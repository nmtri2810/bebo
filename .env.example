# PostgreSQL
POSTGRES_DB=bebo
POSTGRES_USER=bebo
POSTGRES_PASSWORD=bebo
POSTGRES_HOST_PORT=5433

# Local Docker ports
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Backend server
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000

# Backend database connection
DATABASE_URL=jdbc:postgresql://localhost:5433/bebo
DATABASE_USERNAME=bebo
DATABASE_PASSWORD=bebo

# JWT
JWT_SECRET=YmViby1kZXYtc2VjcmV0LW11c3QtYmUtYXQtbGVhc3QtMzItYnl0ZXM=
JWT_ISSUER=bebo-backend
JWT_ACCESS_TOKEN_TTL=PT24H

# Telegram integration
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CONNECTION_TOKEN_TTL=PT10M
TELEGRAM_POLL_DELAY_MS=3000

# Discord integration
DISCORD_BOT_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:8080/api/public/notification-channels/discord/callback
DISCORD_FRONTEND_REDIRECT_URL=http://localhost:3000/settings
DISCORD_STATE_TTL=PT10M

# Reminder scheduler
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_CRON=0 * * * * *
REMINDER_RETRY_CRON=15 * * * * *
REMINDER_RETRY_BATCH_SIZE=100
REMINDER_FIRST_RETRY_DELAY=PT5M
REMINDER_SECOND_RETRY_DELAY=PT15M
REMINDER_THIRD_RETRY_DELAY=PT30M
REMINDER_MAX_OVERDUE_DAYS=14
